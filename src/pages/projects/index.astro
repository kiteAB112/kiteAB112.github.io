---
import { getCollection } from 'astro:content';
import CollectionLayout from '../../layouts/CollectionLayout.astro';
import { byDate } from '../../utils/content';
const entries = (await getCollection('projects', entry => !entry.data.draft)).sort(byDate);
---
<CollectionLayout title="项目" description="面向真实问题的项目成果：目标、架构、关键取舍和可验证产物。" entries={entries} emptyText="项目将在完成第一个可公开版本后出现。">
  <a slot="navigation" href="/stars/">开源收藏 →</a>
</CollectionLayout>
