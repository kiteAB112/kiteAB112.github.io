---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import IconRss from '../assets/icons/IconRss.svg';
import IconGithub from '../assets/icons/socials/github.svg';
import IconArrowRight from '../assets/icons/IconArrowRight.svg';
import { getReadingEntries } from '../utils/content';
import { site } from '../config/site';
const entries = await getReadingEntries();
const featured = entries.filter(entry => entry.data.featured);
const recent = entries.filter(entry => !entry.data.featured).slice(0, 5);
---
<BaseLayout>
  <section class="border-border border-b pt-8 pb-7">
    <div class="flex items-baseline gap-4"><h1 class="my-5 text-4xl font-bold sm:my-8 sm:text-5xl">你好，我是 wuhu</h1><a href="/rss.xml" class="text-accent" aria-label="订阅 RSS"><IconRss width={22} height={22} /></a></div>
    <figure class="my-2">
      <blockquote class="text-lg leading-9">魔法，还是寻找它的时候最有趣啊。</blockquote>
      <figcaption class="mt-3 text-sm text-muted-foreground">—— <cite class="not-italic">《葬送的芙莉莲》</cite></figcaption>
    </figure>
    <div class="mt-5 flex items-center gap-4 text-sm"><a href={site.github} class="inline-flex items-center gap-2 hover:text-accent"><IconGithub width={21} height={21} />GitHub</a><a href="/about/" class="quiet-link">关于我 →</a></div>
  </section>
  {featured.length > 0 && <section class="border-border border-b pt-10 pb-2"><h2 class="text-2xl font-semibold">精选文章</h2><EntryList entries={featured} heading="h3" /></section>}
  <section class="pt-10"><h2 class="text-2xl font-semibold">最新文章</h2><EntryList entries={recent} heading="h3" /></section>
  <div class="my-10 text-center"><a href="/articles/" class="inline-flex items-center gap-2 hover:text-accent">全部文章<IconArrowRight width={22} height={22} /></a></div>
</BaseLayout>
