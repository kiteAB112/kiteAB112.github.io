---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { starGroups, starNotes } from "../../data/stars";
const starred = [...new Set(starGroups.flatMap(group => group.repositories))];
const notesByRepo = new Map(starNotes.map(note => [note.repository, note]));
const id = (name: string) => name.toLowerCase().replaceAll(" ", "-");
---

<BaseLayout title="Stars · Wuhulahu2" description="GitHub 收藏与个人分类索引。">
  <section class="page-heading stars-heading">
    <p class="eyebrow">/stars</p><h1>Stars</h1>
    <p>共 {starred.length} 个 GitHub 收藏，均已按我的学习与研究方向归档。</p>
  </section>
  <nav class="star-list-nav" aria-label="Stars 分类">
    {starGroups.map((list) => <a href={`#${id(list.name)}`}>{list.name} <span>{list.repositories.length}</span></a>)}
  </nav>
  <div class="star-groups">
    {starGroups.map((list) => <section class="star-group" id={id(list.name)}>
      <header><div><p class="eyebrow">/list</p><h2>{list.name}</h2></div><span>{list.repositories.length} 个项目</span></header>
      {list.description && <p class="star-group-description">{list.description}</p>}
      <div class="star-grid">{list.repositories.map((fullName) => <a class="star-card" href={notesByRepo.has(fullName) ? "/stars/" + notesByRepo.get(fullName)!.id + "/" : `https://github.com/${fullName}`} ><span>{fullName.split('/')[0]}</span><strong>{fullName.split('/')[1]}</strong></a>)}</div>
    </section>)}
  </div>
</BaseLayout>
