---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { adjacentEntries, sourceUrl } from '../../utils/content';
export async function getStaticPaths() {
  return (await getCollection('articles', entry => !entry.data.draft))
    .map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'articles'>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const adjacent = adjacentEntries(await getCollection('articles'), entry);
---
<ArticleLayout meta={entry.data} headings={headings} back={{ href: '/articles/', label: '文章' }}
  sourcePath={sourceUrl(entry.filePath)!} linkTags adjacent={adjacent}
  discussionId={entry.data.discussionId ?? 'articles/' + entry.id}>
  <Content />
</ArticleLayout>
