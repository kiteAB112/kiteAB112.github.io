---
import IconCalendar from '../assets/icons/IconCalendar.svg';
import { dateLabel, entryLabel, entryUrl, type Entry } from '../utils/content';
interface Props { entries: Entry[]; emptyText?: string; heading?: 'h2' | 'h3'; }
const { entries, emptyText = '这里还没有公开内容。', heading: Heading = 'h2' } = Astro.props;
---
{entries.length ? <ul class="entry-list">
  {entries.map(entry => <li class="my-7">
    <a href={entryUrl(entry)} class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline"><Heading>{entry.data.title}</Heading></a>
    <div class="entry-date"><IconCalendar aria-hidden="true" /><span>{entry.data.updated ? '更新于 ' : ''}<time datetime={(entry.data.updated ?? entry.data.published).toISOString()}>{dateLabel(entry.data.updated ?? entry.data.published)}</time><span aria-hidden="true"> · </span>{entryLabel(entry)}{entry.data.draft && ' · 草稿预览'}</span></div>
    <p class="mt-1 leading-7">{entry.data.description}</p>
  </li>)}
</ul> : <p class="my-8 text-muted-foreground">{emptyText}</p>}
